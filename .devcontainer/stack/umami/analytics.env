# App-facing analytics settings: loaded via env_file: into myapp
# (.devcontainer/compose.instance.yml) and the umami-seed one-shot (compose.yml,
# next to this file), so ANALYTICS_SITE_ID has one source of truth. Holds no
# secrets; Umami's own DATABASE_URL and APP_SECRET stay in umami.env.
# Read by the app, not by Umami: where and how to send analytics events.
ANALYTICS_BACKEND=umami
ANALYTICS_ENDPOINT=http://umami:3000
ANALYTICS_SITE_ID=a076165c-04f6-5693-94ad-a3ae8ca0c316
# Event property keys the app may send (everything else is dropped), and the
# hostname Umami records events under.
ANALYTICS_PROP_KEYS=powers_count
ANALYTICS_HOSTNAME=template-axum.craftainer.local
