      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Vance",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "uma_authorization"
      ],
      "clientRoles": {
        "api": [
          "viewer"
        ]
      }
    },
