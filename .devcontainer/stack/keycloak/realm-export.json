{
  "realm": "template-axum",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "api",
      "name": "template-axum API",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "api": [
        {
          "name": "viewer",
          "description": "Read-only access to Hero routes"
        },
        {
          "name": "editor",
          "description": "Read/create/update access to Hero routes"
        },
        {
          "name": "maintainer",
          "description": "Full CRUD access to Hero routes, including delete"
        },
        {
          "name": "security",
          "description": "Access to /audit"
        },
        {
          "name": "detective",
          "description": "Read-only access to Hero routes, plus /audit"
        }
      ]
    }
  },
  "users": [
    {
      "username": "viewer",
      "enabled": true,
