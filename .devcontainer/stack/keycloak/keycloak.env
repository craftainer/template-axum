# Keycloak local-dev credentials and OIDC endpoints: loaded via env_file:
# into both the keycloak service (compose.yml, next to this file, which
# only consumes KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD) and api
# (.devcontainer/compose.yml, whose Settings reads the OIDC_* values
# verbatim -- see the application's config module (phase 2)). The realm/client-id baked into the
# OIDC_* URLs below must be kept in sync by hand with realm-export.json --
# see CLAUDE.md's "Devcontainer stack pattern" section.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://keycloak:8080/realms/template-axum
OIDC_AUTHORIZATION_URL=http://keycloak:8080/realms/template-axum/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://keycloak:8080/realms/template-axum/protocol/openid-connect/token
OIDC_CLIENT_ID=api
OIDC_AUDIENCE=api
