# Postgres local-dev credentials: loaded via env_file: into both the
# postgres service (compose.yml, next to this file) and api
# (.devcontainer/compose.yml, which assembles DATABASE_URL from these in
# the application's config module (phase 2)). See CLAUDE.md's "Configuration" section.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
